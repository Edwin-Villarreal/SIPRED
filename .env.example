APP_NAME=SIPRED
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sipred
DB_USERNAME=root
DB_PASSWORD=
DB_ENGINE=InnoDB

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SIPRED_ADMIN_EMAIL=admin@sipred.local
SIPRED_ADMIN_PASSWORD=
VITE_APP_NAME="${APP_NAME}"

SIPRED_IOT_API_URL=http://127.0.0.1:8000
SIPRED_IOT_CONNECTIVITY_TIMEOUT=300
